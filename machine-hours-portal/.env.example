# Copy to .env and edit. All settings are optional unless noted.
PORT=3000
HOST=0.0.0.0
# Public address used in email links
APP_URL=http://your-server-name:3000
# DATA_DIR=./data

# ---- Superusers ----------------------------------------------------------
# Owner superusers (comma-separated). They are always superusers and cannot be
# removed from inside the app. More superusers are added in the app (Superuser → Users & roles).
SUPERUSER_EMAILS=nicholas.william_davies_c@sandvik.com

# ---- Storage -------------------------------------------------------------
# file       = data/db.json on this server (ephemeral on Render free services)
# postgres   = Render PostgreSQL (DATABASE_URL required; local JSON remains a cache)
# sharepoint = SharePoint Online lists via Microsoft Graph (data/db.json is kept as an offline cache)
STORAGE=file
# For Render PostgreSQL, add DATABASE_URL in the Render environment (STORAGE then defaults to postgres).
# DATABASE_SSL=true|false overrides automatic TLS detection (off for internal/localhost hosts, on otherwise).

# ---- Keep-alive (Render free plan sleeps after 15 min without traffic) -----
# On Render this is on automatically (pings RENDER_EXTERNAL_URL/api/health every 10 min).
# KEEP_ALIVE_MINUTES=10
# KEEP_ALIVE_URL=https://your-service.onrender.com
# KEEP_ALIVE=off

# SharePoint — easiest: Superuser → Data source in the app (no need to edit this file).
# Or set it here (this wins over the app):
# SP_TENANT_ID=00000000-0000-0000-0000-000000000000
# SP_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SP_CLIENT_SECRET=
# SP_SITE_URL=https://yourtenant.sharepoint.com/sites/MachineHours
# SP_LIST_PREFIX=MHP_
# Minutes between reads of SharePoint (picks up edits made directly in the lists)
# SP_PULL_MINUTES=5
# Let the portal create missing lists/columns itself (the app then needs "manage" on the site)
# SP_CREATE_LISTS=false

# ---- Email notifications (requires: npm install nodemailer) ----------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=machine-hours@yourdomain.com
# SMTP_PASS=
# SMTP_FROM="Machine Hours Portal <machine-hours@yourdomain.com>"

# ---- HTTPS (optional; needed for full offline use and "install" on phones) ----
# TLS_CERT=C:\certs\portal.crt
# TLS_KEY=C:\certs\portal.key
# or a .pfx file:
# TLS_PFX=C:\certs\portal.pfx
# TLS_PASSPHRASE=
